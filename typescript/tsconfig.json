{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "plugins/**/*.ts",
    "test/**/*.ts",
    "cli/**/*.ts"
  ]
}
