
# Targeted lookup: `getfrom` and `tryfrom`.
#
# Where `resolve` walks the whole chain, these address ONE store by name.
# That makes them the escape hatch when precedence is not what you want —
# and it means a miss in the named store is a miss, full stop, even when a
# later store in the chain does have the secret.


getfrom: set: [
  {
    id: 'getfrom#named', doc: true
    in: {
      chain: [
        { kind: 'memory', name: 'local', values: { API_TOKEN: 'LOCAL' } }
        { kind: 'memory', name: 'shared', values: { API_TOKEN: 'SHARED' } }
      ]
      store: 'shared'
      name: 'api.token'
    }
    out: 'SHARED'
  }

  # The same chain, addressed the other way: chain order does not decide.
  {
    in: {
      chain: [
        { kind: 'memory', name: 'local', values: { API_TOKEN: 'LOCAL' } }
        { kind: 'memory', name: 'shared', values: { API_TOKEN: 'SHARED' } }
      ]
      store: 'local'
      name: 'api.token'
    }
    out: 'LOCAL'
  }

  # An unnamed source is addressable by its kind.
  {
    in: {
      chain: [ { kind: 'memory', values: { API_TOKEN: 'T' } } ]
      store: 'memory'
      name: 'api.token'
    }
    out: 'T'
  }

  # When one name covers several sources, they are searched in chain order.
  {
    in: {
      chain: [
        { kind: 'memory', name: 'pair', values: {} }
        { kind: 'memory', name: 'pair', values: { API_TOKEN: 'SECOND' } }
      ]
      store: 'pair'
      name: 'api.token'
    }
    out: 'SECOND'
  }

  # Missing secret and missing store are different errors: the first says
  # where it looked, the second says the name is not addressable at all.
  {
    in: {
      chain: [ { kind: 'memory', name: 'local', values: {} } ]
      store: 'local'
      name: 'api.token'
    }
    err: 'sekreto: unknown secret: local:api.token'
  }
  {
    in: {
      chain: [ { kind: 'memory', name: 'local', values: { API_TOKEN: 'T' } } ]
      store: 'nosuch'
      name: 'api.token'
    }
    err: 'sekreto: unknown store: nosuch'
  }

  {
    in: {
      chain: [ { kind: 'memory', values: { API_TOKEN: 'T' } } ]
      store: 'memory'
      name: 'a b'
    }
    err: 'invalid name'
  }

  # Refusing plaintext is a client-side check, so it fires before any
  # connection is attempted — no server is contacted by these two.
  {
    doc: true
    in: {
      chain: [ { kind: 'hashicorp', addr: 'http://vault.example.com:8200' } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'sekreto: refusing to send a token in plaintext to http://vault.example.com:8200 (use https)'
  }
  {
    in: {
      chain: [ { kind: 'hashicorp', addr: 'ftp://vault.example.com' } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'sekreto: not an http(s) address: ftp://vault.example.com'
  }

  # NO REFUSAL PRINTS THE CREDENTIAL IT IS REFUSING.
  #
  # Every message here names the address, and one of them fires precisely
  # because that address carries a password - so printing it verbatim
  # wrote the password to stderr and into the logs. It cannot be cleaned
  # up afterwards either: the password was never resolved as a secret, so
  # `redact` has never seen it. The host is what identifies the offending
  # chain entry; the userinfo is not. This case is the scheme branch,
  # which fires before any of the parsing and leaked too.
  {
    in: {
      chain: [ { kind: 'hashicorp', addr: 'ftp://svc:hunter2@vault.example.com/' } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'sekreto: not an http(s) address: ftp://[redacted]@vault.example.com/'
  }

  # USERINFO, refused outright.
  #
  # `localhost:8200@evil.example.com` is a request to evil.example.com,
  # but a port that finds the host by splitting the authority on ':'
  # reads it as `localhost`, allows it, and sends the vault token in the
  # clear to the attacker - defeating the one check that exists to
  # prevent exactly that. Eight of the twelve ports did this.
  #
  # The fix is not to locate the userinfo more carefully but to refuse
  # any address that has one. No store this library speaks authenticates
  # by userinfo, so such an address is a mistake whatever the host; and
  # "does the authority contain an '@'" is a question twelve ports answer
  # identically, where "where does the userinfo end" is not.
  {
    in: {
      chain: [ { kind: 'hashicorp', addr: 'http://localhost:8200@evil.example.com/' } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'sekreto: refusing an address with embedded credentials: http://[redacted]@evil.example.com/'
  }

  # The same trick without a colon in the userinfo, which the splitting
  # implementations happened to refuse. It must still refuse, and for the
  # stated reason.
  {
    in: {
      chain: [ { kind: 'hashicorp', addr: 'http://127.0.0.1@evil.example.com/' } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'sekreto: refusing an address with embedded credentials: http://[redacted]@evil.example.com/'
  }

  # Two @ signs. The URL parsers split this one four different ways
  # across the twelve platforms; refusing the shape makes them agree.
  {
    in: {
      chain: [ { kind: 'hashicorp', addr: 'http://a@127.0.0.1@evil.example.com/' } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'sekreto: refusing an address with embedded credentials: http://[redacted]@evil.example.com/'
  }

  # Refused on https too, where there is no plaintext argument for it -
  # an address that carries credentials is simply not one this library
  # accepts.
  {
    in: {
      chain: [ { kind: 'hashicorp', addr: 'https://user:pass@vault.example.com' } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'sekreto: refusing an address with embedded credentials: https://[redacted]@vault.example.com'
  }

  # An '@' after the authority is part of the path, and the path is not
  # this check's business. Reaching 'unsupported kv version' is how a
  # case proves the address was ALLOWED: that error comes from the
  # provider, after the check let it through.
  {
    in: {
      chain: [ { kind: 'hashicorp', addr: 'http://localhost:8200/a@b', token: 't', kv: 3 } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'unsupported kv version'
  }

  # And the converse: a bracketed IPv6 loopback is LEGITIMATE and must be
  # allowed. Splitting on ':' yields '[' and refuses a real local vault,
  # which is how this bug first showed itself.
  {
    in: {
      chain: [ { kind: 'hashicorp', addr: 'http://[::1]:8200', token: 't', kv: 3 } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'unsupported kv version'
  }

  # Case is not part of a host's identity. Every URL parser folds it; the
  # two ports that must parse by hand have to fold it themselves.
  {
    in: {
      chain: [ { kind: 'hashicorp', addr: 'http://LOCALHOST:8200', token: 't', kv: 3 } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'unsupported kv version'
  }

  # An IPv4-mapped IPv6 loopback is deliberately NOT in the allowlist.
  # Widening the set of addresses that count as local is a separate
  # decision from parsing the host correctly, and it has not been made.
  {
    in: {
      chain: [ { kind: 'hashicorp', addr: 'http://[::ffff:127.0.0.1]:8200' } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'sekreto: refusing to send a token in plaintext to http://[::ffff:127.0.0.1]:8200 (use https)'
  }

  # An address that is not an address. It is refused for being malformed
  # rather than for being remote, because "this is not a URL" is the
  # accurate thing to tell whoever wrote the config.
  {
    in: {
      chain: [ { kind: 'hashicorp', addr: 'http://[::1' } ]
      store: 'hashicorp'
      name: 'api.token'
    }
    err: 'sekreto: not a valid http(s) address: http://[::1'
  }
]


# Same lookup, miss reported as null. An unknown STORE still raises: that
# is a configuration bug, not a missing secret.
tryfrom: set: [
  {
    id: 'tryfrom#hit', doc: true
    in: {
      chain: [ { kind: 'memory', name: 'local', values: { API_TOKEN: 'T' } } ]
      store: 'local'
      name: 'api.token'
    }
    out: 'T'
  }
  {
    in: {
      chain: [ { kind: 'memory', name: 'local', values: {} } ]
      store: 'local'
      name: 'api.token'
    }
    out: '__NULL__'
  }

  # The secret exists in the chain, but not in the store asked for.
  {
    in: {
      chain: [
        { kind: 'memory', name: 'local', values: {} }
        { kind: 'memory', name: 'shared', values: { API_TOKEN: 'S' } }
      ]
      store: 'local'
      name: 'api.token'
    }
    out: '__NULL__'
  }

  {
    in: {
      chain: [ { kind: 'memory', name: 'local', values: {} } ]
      store: 'nosuch'
      name: 'api.token'
    }
    err: 'sekreto: unknown store: nosuch'
  }
]
