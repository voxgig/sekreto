
# Redaction: replace known secret values in text before it is logged.
#
# The short-value rule is the interesting one. Redacting a 3-character
# secret would blank out unrelated text everywhere it happens to occur, so
# values below the length threshold are left alone — better a leak the
# caller can see than a log that quietly rewrites itself.


redact: set: [
  {
    id: 'redact#one', doc: true
    in: { text: 'token is s3cr3t-value', values: [ 's3cr3t-value' ] }
    out: 'token is [redacted]'
  }

  # No occurrence, no change.
  {
    in: { text: 'nothing here', values: [ 's3cr3t' ] }
    out: 'nothing here'
  }

  # Every value, and every occurrence of each.
  {
    in: { text: 'a=AAAA b=BBBB', values: [ 'AAAA', 'BBBB' ] }
    out: 'a=[redacted] b=[redacted]'
  }
  {
    in: { text: 'twice AAAA and AAAA', values: [ 'AAAA' ] }
    out: 'twice [redacted] and [redacted]'
  }

  # Too short to redact safely — left as-is.
  {
    in: { text: 'short abc', values: [ 'abc' ] }
    out: 'short abc'
  }

  # An empty value would match everywhere; it must be ignored outright.
  {
    in: { text: 'empty', values: [ '' ] }
    out: 'empty'
  }

  # Empty text stays empty.
  {
    in: { text: '', values: [ 'AAAA' ] }
    out: ''
  }

  # LONGEST FIRST, whatever order the values arrived in.
  #
  # A shorter secret that prefixes a longer one used to eat the prefix
  # and leave the rest in the log. That is not a contrived pair: with
  # `db.pass` = 'abcd' from the environment and `api.token` = 'abcd1234'
  # from the vault, whichever resolved first went into `seen` first, so
  # an ordinary two-secret chain decided it - and resolving the weaker
  # store first is the common arrangement.
  {
    in: { text: 'token=abcd1234', values: [ 'abcd', 'abcd1234' ] }
    out: 'token=[redacted]'
  }

  # The same pair the other way round, which always worked. Both orders
  # are here so the case cannot be satisfied by luck.
  {
    in: { text: 'token=abcd1234', values: [ 'abcd1234', 'abcd' ] }
    out: 'token=[redacted]'
  }

  # And the shorter one is still redacted where it stands alone.
  {
    in: { text: 'pass=abcd token=abcd1234', values: [ 'abcd', 'abcd1234' ] }
    out: 'pass=[redacted] token=[redacted]'
  }
]
